{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.sh\" ko",
            "timeout": 10,
            "statusMessage": "AI 법전 로드"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.sh\" ko SubagentStart",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
